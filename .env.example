# Microsoft Clarity Data Export API token.
# Clarity project -> Settings -> Data Export -> Generate new API token.
# This is a long-lived JWT. Keep it out of source control.
CLARITY_API_TOKEN=

# Shared secret that MCP clients must present:
#   Authorization: Bearer <MCP_BRIDGE_SECRET>
# Generate one with: openssl rand -hex 32
MCP_BRIDGE_SECRET=

# Postgres connection string for Prisma.
DATABASE_URL=postgresql://clarity:clarity@localhost:5432/clarity_mcp

# Optional: how long a cached Clarity response is considered "fresh", in ms.
# Default 21600000 (6h). Stale cache is still served without spending an API call
# unless the caller explicitly forces a refresh.
CLARITY_CACHE_TTL_MS=21600000
