# ===========================================================================
# clarity-mcp environment. Copy to .env and fill in. No real secrets here.
# ===========================================================================

# --- Core -----------------------------------------------------------------
# Postgres connection string for Prisma.
DATABASE_URL=postgresql://clarity:clarity@localhost:5432/clarity_mcp

# Shared secret every MCP client must send as: Authorization: Bearer <secret>
# Generate: openssl rand -hex 32
MCP_BRIDGE_SECRET=

# --- MCP transport ------------------------------------------------------
# Comma-separated allowed browser Origin header values. Empty = allow all
# (non-browser MCP clients send no Origin).
MCP_ALLOWED_ORIGINS=
# Comma-separated allowed Host header values (DNS-rebinding protection). Empty = allow all.
MCP_ALLOWED_HOSTS=
# Require a spec-strict Accept header (application/json AND text/event-stream).
# Default false: a lenient legacy client's Accept header is normalized.
MCP_STRICT_ACCEPT=false
# Max JSON-RPC request body size in bytes (default 5 MiB).
MCP_MAX_BODY_BYTES=5242880

# --- Clarity aggregate Data Export API -------------------------------
# Clarity project -> Settings -> Data Export -> Generate new API token (a JWT).
CLARITY_API_TOKEN=
# How long a cached response is "fresh", in ms (default 21600000 = 6h).
CLARITY_CACHE_TTL_MS=21600000
# Stale-cache policy when quota remains:
#   revalidate (default) -> refresh now, return fresh data
#   stale               -> return stale data + warning; refresh only on forceRefresh
CLARITY_REFRESH_POLICY=revalidate

# --- Clarity recording CSV import ----------------------------------
CLARITY_CSV_MAX_BYTES=26214400
CLARITY_CSV_MAX_ROWS=200000

# --- Storage ---------------------------------------------------------
# filesystem (default). Keep a persistent volume mounted at STORAGE_DIR.
STORAGE_DRIVER=filesystem
STORAGE_DIR=./storage

# --- Video ingest limits ------------------------------------------
VIDEO_MAX_BYTES=524288000
VIDEO_MAX_DURATION_SEC=10800
VIDEO_KEYFRAME_INTERVAL_SEC=15
VIDEO_MAX_KEYFRAMES=120
VIDEO_SCENE_THRESHOLD=0.4
DOWNLOAD_CONNECT_TIMEOUT_MS=15000
DOWNLOAD_TOTAL_TIMEOUT_MS=600000
DOWNLOAD_MAX_REDIRECTS=3
# Allow http:// + private/loopback download targets. Default: true off-prod, false in prod.
ALLOW_INSECURE_URLS=

# --- FFmpeg --------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Worker ------------------------------------------------------
WORKER_ID=
WORKER_POLL_INTERVAL_MS=3000
WORKER_JOB_TIMEOUT_MS=1800000
WORKER_STALE_LOCK_MS=900000

# --- Providers (speech-to-text, vision, synthesis / QA) --------
# Provider per capability: openai (default) | mock (test/dev only)
STT_PROVIDER=openai
VISION_PROVIDER=openai
SYNTHESIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
STT_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini
SYNTHESIS_MODEL=gpt-4o-mini
# Force-enable the mock providers outside tests (never do this in production).
PROVIDERS_ALLOW_MOCK=false

# --- Tests -----------------------------------------------------
# Point database-backed test suites at a real Postgres. Unset -> those suites skip.
TEST_DATABASE_URL=
